# ---- LeafMachine3 ----
# Trained model artifacts are NOT committed (shipped separately / linked in).
# Ignore the whole tree: the per-extension rules below kept missing formats (.bin, .mlmodel),
# which left models/ (1.3 GB) staged as untracked and one `git add -A` away from the history.
models/
models/**/*.onnx
models/**/*.pt
models/**/*.torchscript
models/**/*_openvino_model/
models/**/*.mlpackage
models/ruler_classifier


# machine-derived + run outputs
# Collage project: 342 GB, of which output_LM3_for_collage/ is 337 GB of generated LM3 run
# output. Excluded entirely at Will's direction (2026-08-28).
global_leaf_margin_collage/
hardware_settings.yaml
/runs/
/output/
*.sqlite
*.sqlite-wal
*.sqlite-shm
_tmp/

# ---- Node / Electron ----
# Reproducible from the tracked app/package-lock.json via `npm ci`; 271 MB otherwise.
node_modules/

# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
.venv_*/
venv/
.env
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ---- OS / editor ----
.DS_Store
.idea/
.vscode/
*.swp

# example / test data + generated demo artifacts (not committed)

# test/run outputs (one subdir per test/run name)
examples_out/

# ---- Electron packaging (app/electron-builder.yml) ----
# Build output: one unpacked ~250 MB tree plus an AppImage/deb/tar.gz per Linux target, and
# considerably more once Windows and macOS targets are built. Never committed.
/app/dist/
# electron-builder's local caches, if a build is ever run with a project-local cache dir.
/app/.cache/
# ...but app/build/ is TRACKED packaging input (icon, entitlements, icon generator). The generic
# Python `build/` rule above matches any directory named "build" at any depth and would swallow
# it, so re-include it here. This negation must stay AFTER that rule to take effect.
!/app/build/

# Raw verification material from the Step 1/2 closeout. Deliberately NOT committed: it carries the
# machine key, GPU UUIDs, node name, absolute home paths and full pytest output. The committed,
# sanitized equivalents are docs/verification/STEP2_VERIFICATION_SUMMARY.md and
# docs/verification/STEP2_BASELINE_NODE_IDS.txt.
.step2_evidence/
