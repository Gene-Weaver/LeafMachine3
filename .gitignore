# ---- LeafMachine3 ----
# Trained model artifacts are NOT committed (shipped separately / linked in).
# Ignore the whole tree: the per-extension rules below kept missing formats (.bin, .mlmodel),
# which left models/ (1.3 GB) staged as untracked and one `git add -A` away from the history.
models/
models/**/*.onnx
models/**/*.pt
models/**/*.torchscript
models/**/*_openvino_model/
models/**/*.mlpackage
models/ruler_classifier


