# The single source for every tool and platform identity an LM3 release pins.
# Read by: pyproject.toml ([tool.uv] required-version), .python-version, the env contract
# (tools/release/write_env_contract.py -> leafmachine3/_env_contract.json -> `lm3 doctor`),
# README.md (Setup with Verification Steps), and later the Dockerfiles. tests/test_release_identity.py asserts they agree.
PYTHON_VERSION=3.11.17
UV_VERSION=0.12.23
# Minimum NVIDIA driver for the CUDA 12.4 runtime wheels the gpu extra ships
# (CUDA 12.4 release notes, "CUDA Toolkit and Corresponding Driver Versions").
CUDA_MIN_DRIVER_LINUX=525.60.13
CUDA_MIN_DRIVER_WINDOWS=528.33
